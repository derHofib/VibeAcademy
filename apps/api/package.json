    "@sn/db": "workspace:*",
    "@sn/shared": "workspace:*",
    "argon2": "^0.45.2",
    "bullmq": "^5.81.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "nodemailer": "^7.0.13",
    "openid-client": "^6.9.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
