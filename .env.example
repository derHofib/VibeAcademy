# ── Datenbank ────────────────────────────────────────────────
# Superuser nur für Bootstrap (Rollen, Datenbank, Extensions)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
DB_NAME=schulungsnachweis
# Owner der Tabellen, führt Migrationen aus
DB_MIGRATOR_PASSWORD=change-me-migrator
DATABASE_MIGRATOR_URL=postgres://app_migrator:change-me-migrator@127.0.0.1:54329/schulungsnachweis
# Laufzeitrolle der API (ohne BYPASSRLS)
DB_APP_PASSWORD=change-me-app
DATABASE_URL=postgres://app_user:change-me-app@127.0.0.1:54329/schulungsnachweis

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:63799

# ── API ──────────────────────────────────────────────────────
API_PORT=3000
PUBLIC_BASE_URL=http://localhost:5173
# 32+ zufällige Bytes, z. B. `openssl rand -base64 48`
SESSION_SECRET=
# Master-Secret für HMAC (Einladungs-Tokens, QR-Tokens, IP-Hashes)
HMAC_MASTER_SECRET=

# ── Benachrichtigungen (E-12) ────────────────────────────────
# log | smtp
MAIL_PROVIDER=log
MAIL_FROM="Schulungsnachweis <no-reply@example.org>"
SMTP_URL=smtp://127.0.0.1:1025
# log
SMS_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ── Objektspeicher (MinIO/S3) ────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=sn-uploads
S3_BUCKET_EVIDENCE=sn-evidence

# ── Nachweis-PDF und Siegel (E-09, E-10) ─────────────────────
GOTENBERG_URL=http://127.0.0.1:3001
SEAL_P12_PATH=infra/dev-certs/out/seal.p12
SEAL_P12_PASSWORD=
# leer = interner Test-TSA (nicht qualifiziert)
TSA_URL=
