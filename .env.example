# ── Betrieb (Docker Compose) ─────────────────────────────────
# Domain für Caddy (TLS automatisch); lokal: localhost
SITE_ADDRESS=localhost
POSTGRES_PASSWORD=change-me-postgres

# ── Datenbank ────────────────────────────────────────────────
# Superuser nur für Bootstrap (Rollen, Datenbank, Extensions)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
DB_NAME=schulungsnachweis
# Owner der Tabellen, führt Migrationen aus
DB_MIGRATOR_PASSWORD=change-me-migrator
DATABASE_MIGRATOR_URL=postgres://app_migrator:change-me-migrator@127.0.0.1:54329/schulungsnachweis
# Laufzeitrolle der API (ohne BYPASSRLS)
DB_APP_PASSWORD=change-me-app
DATABASE_URL=postgres://app_user:change-me-app@127.0.0.1:54329/schulungsnachweis

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:63799

# ── API ──────────────────────────────────────────────────────
API_PORT=3000
# Docker Compose setzt 0.0.0.0 (API nur im internen Netz, Port nicht veröffentlicht)
API_HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:5173
# 32+ zufällige Bytes, z. B. `openssl rand -base64 48`
SESSION_SECRET=
# Master-Secret für HMAC (Einladungs-Tokens, QR-Tokens, IP-Hashes)
HMAC_MASTER_SECRET=

# ── Login-Sperre (Login, Step-up, Passwort ändern) ─────────
# Je E-Mail-Adresse: so viele Fehlversuche frei (leer = 5; NODE_ENV=development: 100), danach Sperre BASE,
# 2·BASE, 4·BASE … Sekunden bis MAX; Zähler verfällt nach MAX Sekunden ohne Fehlversuch.
LOGIN_LOCK_FREE_ATTEMPTS=
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=86400

# ── Benachrichtigungen (E-12) ────────────────────────────────
# log | smtp
MAIL_PROVIDER=log
MAIL_FROM="Schulungsnachweis <no-reply@example.org>"
SMTP_URL=smtp://127.0.0.1:1025
# log
SMS_PROVIDER=log
# Web-Push: leer = Push nur ins Log. Schlüssel erzeugen: pnpm --filter @sn/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ── SSO / SCIM (E-36) ───────────────────────────────────────
# IdP-Konfiguration je Mandant in der Oberfläche (Einstellungen → Anmeldung & Benutzerverwaltung).
# Redirect-URI beim IdP eintragen: <PUBLIC_BASE_URL>/api/auth/sso/callback · SCIM-Basis-URL: <PUBLIC_BASE_URL>/api/scim/v2
# Client-Secrets werden mit einem aus HMAC_MASTER_SECRET abgeleiteten Schlüssel verschlüsselt (Secret nicht wechseln, sonst neu eintragen).
# true = Issuer über http erlauben (nur lokaler Test-IdP; in Produktion wirkungslos)
SSO_ALLOW_HTTP_ISSUER=false

# ── REST-API und Webhooks (E-37) ────────────────────────────
# API-Schlüssel und Webhooks je Mandant in der Oberfläche (Verwaltung → Schnittstellen); OpenAPI: <PUBLIC_BASE_URL>/api/v1/openapi.json
# Webhook-Geheimnisse werden mit einem aus HMAC_MASTER_SECRET abgeleiteten Schlüssel verschlüsselt.
API_RATE_LIMIT_PER_MINUTE=600
# Versuche je Zustellung; n-ter Fehlversuch wartet BACKOFF_BASE · 2^(n−1) ms; Endpunkt nach so vielen Fehlversuchen in Folge abschalten
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_BASE_MS=60000
WEBHOOK_DISABLE_AFTER_FAILURES=20
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_POLL_MS=5000
# leer = http://localhost und private Ziele nur außerhalb der Produktion; true = auch in Produktion (Ziele im Intranet)
WEBHOOK_ALLOW_PRIVATE=

# ── Externe Nachweise (OCR mit Tesseract „deu“, E-18) ───────
TESSERACT_BIN=tesseract
OCR_LANG=deu
EXTERNAL_UPLOAD_MAX_MB=20
# Rückgängig nach Freigabe (Minuten); danach nur noch über einen neuen Nachweis
EXTERNAL_UNDO_MINUTES=10

# ── Objektspeicher (MinIO/S3) ────────────────────────────────
# fs = lokales Verzeichnis (Entwicklung/Tests), s3 = MinIO/S3 (Betrieb, Object Lock)
STORAGE_DRIVER=fs
STORAGE_DIR=.local/storage
S3_ENDPOINT=http://127.0.0.1:9000
UPLOAD_MAX_MB=50
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=sn-uploads
S3_BUCKET_EVIDENCE=sn-evidence

# ── Nachweis-PDF und optionales Siegel (E-09, E-10, E-45) ──────
# none = ohne Siegel/Zeitstempel (Standard, gesetzlich nicht nötig); pyhanko = PAdES-Siegel + RFC-3161-Zeitstempel
SEAL_MODE=none
GOTENBERG_URL=http://127.0.0.1:3001
SEAL_P12_PATH=infra/dev-certs/out/seal.p12
SEAL_P12_PASSWORD=
# leer = interner Test-TSA (nicht qualifiziert)
TSA_URL=
