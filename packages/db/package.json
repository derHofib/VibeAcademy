{
  "name": "@sn/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "reset": "tsx src/cli/reset.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.15.0",
    "dotenv": "^17.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
