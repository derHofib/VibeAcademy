# TLS automatisch (Let's Encrypt bzw. lokale CA für „localhost“). Kamera/QR auf iOS braucht HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}

	# API inkl. SSE (flush_interval -1 → keine Pufferung)
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Single-Page-App
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
